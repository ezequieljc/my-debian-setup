#!/usr/bin/env python3

# omarchy:summary=Print the PulseAudio graph as JSON, including non-ASCII names
# omarchy:args=[sinks|sources|sink-inputs|source-outputs]
# omarchy:group=audio
# omarchy:examples=omarchy audio graph | omarchy audio graph sinks

"""Stand-in for `pactl -f json list`.

PulseAudio 17's JSON encoder rejects any non-ASCII byte and leaves the output
unparseable, so one accented name is enough to break it: "Áudio interno" on a
pt_BR system, or a stream titled "Música". The text form has no such limit, so
parse that instead and keep the field names `pactl -f json` uses.
"""

import json
import os
import re
import subprocess
import sys

HEADERS = {
    "sinks": "Sink",
    "sources": "Source",
    "sink-inputs": "Sink Input",
    "source-outputs": "Source Output",
}
PROPERTY = re.compile(r'^\t\t([^\t =]+) = "(.*)"$')
PORT = re.compile(r"^\t\t([^\t:]+): (.*)$")
CHANNEL = re.compile(r"([\w-]+): (\d+) / +(\d+)%")


def port_availability(text):
    if "not available" in text:
        return "not available"
    if "availability unknown" in text:
        return "availability unknown"
    return "available"


def parse(text, header):
    entries = []
    entry = None
    section = None
    start = re.compile(rf"^{re.escape(header)} #(\d+)$")

    for line in text.splitlines():
        match = start.match(line)
        if match:
            entry = {"index": int(match.group(1)), "properties": {}, "ports": []}
            entries.append(entry)
            section = None
            continue
        if entry is None:
            continue

        if line.startswith("\t\t"):
            if section == "properties":
                match = PROPERTY.match(line)
                if match:
                    value = re.sub(r"\\(.)", r"\1", match.group(2))
                    entry["properties"][match.group(1)] = value
            elif section == "ports":
                match = PORT.match(line)
                if match:
                    entry["ports"].append({
                        "name": match.group(1),
                        "availability": port_availability(match.group(2)),
                    })
            continue

        if not line.startswith("\t") or line[1:2] == " ":
            continue

        key, _, value = line[1:].partition(":")
        value = value.strip()
        section = key.lower() if key in ("Properties", "Ports") else None

        if key == "Name":
            entry["name"] = value
        elif key == "Description":
            entry["description"] = value
        elif key == "State":
            entry["state"] = value
        elif key == "Mute":
            entry["mute"] = value == "yes"
        elif key == "Active Port":
            entry["active_port"] = value
        elif key == "Volume":
            entry["volume"] = {
                channel: {"value": int(raw), "value_percent": f"{percent}%"}
                for channel, raw, percent in CHANNEL.findall(value)
            }

    return entries


def read(kind):
    try:
        result = subprocess.run(
            ["pactl", "list", kind],
            env={**os.environ, "LC_ALL": "C"},
            capture_output=True,
            timeout=3,
        )
    except (OSError, subprocess.TimeoutExpired):
        return []
    return parse(result.stdout.decode("utf-8", "replace"), HEADERS[kind])


def main():
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and sys.argv[1] not in HEADERS):
        print(f"Usage: omarchy-audio-graph [{'|'.join(HEADERS)}]", file=sys.stderr)
        return 2

    if len(sys.argv) == 2:
        output = read(sys.argv[1])
    else:
        output = {kind.replace("-", "_"): read(kind) for kind in HEADERS}

    json.dump(output, sys.stdout, ensure_ascii=False)
    print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
